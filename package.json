{
  "name": "@elem-app/arc",
  "version": "0.6.0",
  "description": "Parser and runtime for Arc scripts",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist"
  ],
  "exports": {
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "default": "./dist/parser/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./host-utils": {
      "types": "./dist/host-utils/index.d.ts",
      "default": "./dist/host-utils/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "acorn-walk": "^8.3.4"
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
